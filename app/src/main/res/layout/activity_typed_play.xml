<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg"
        app:navigationIcon="@drawable/ic_back"
        app:title="">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gripButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/accent" />
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/typed_play_search_for"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/promptWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:minHeight="22dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sessionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/faint"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fake search bar: shows what the training keyboard typed. -->
    <TextView
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_typed_input"
        android:hint="@string/typed_input_hint"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/faint"
        android:textSize="20sp" />

    <edu.iot.phoneangle.ui.TapKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="2dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />
</LinearLayout>
