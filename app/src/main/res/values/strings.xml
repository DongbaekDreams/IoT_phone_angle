    <string name="ec_play_title">Prompted words</string>
    <string name="ec_play_blurb">One word at a time. Mix of google / yahoo and hard lookalikes (gmail, youtube…). Use Typo when you mess up — that motion is still saved. More of these beats clever live tricks.</string>
    <string name="ec_play_open">Start prompted words</string>
    <string name="ec_idle_title">Idle recording</string>
    <string name="ec_idle_blurb">Hold and fidget with the phone for about 20 seconds without typing. Teaches live detection what “not typing” looks like — record at least one.</string>
    <string name="ec_idle_open">Record idle</string>
    <string name="ec_train">Train typed models</string>
    <string name="ec_train_blurb">Trains two local models: prompted-word (snipped) and event-driven live flagging (idle + progressive bursts). Not federated.</string>
    <string name="ec_listen_title">Live flagging</string>
    <string name="ec_listen_blurb">Listens for typing bursts. “Flagged” means motion looked like a blocked site-name stand-in (google / yahoo) — parental-filter demo. Uses the Play (snipped) model when available; stays silent otherwise.</string>
    <string name="ec_listen_open">Open live flagging</string>
    <string name="ec_listen_ready">Uses Play model + burst detector (retrain Play if unsure).</string>
</resources>